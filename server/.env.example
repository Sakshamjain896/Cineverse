# Cineverse Backend Environment Variables (placeholders only)
# Copy to .env locally and configure secret values in your hosting provider.

NODE_ENV=development
PORT=5000

# Neon PostgreSQL connection string (include sslmode=verify-full or libpq compatibility)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full

# TMDB API v3 Read Access Token (server-side only; never expose to frontend)
TMDB_ACCESS_TOKEN=your_tmdb_read_access_token_here

# Cryptographically random secret (minimum 32 characters) for JWT & CSRF HMAC signing
JWT_SECRET=replace_with_at_least_32_random_characters_generated_via_openssl_or_crypto
JWT_ISSUER=cineverse-api
JWT_AUDIENCE=cineverse-web

# Frontend origin(s) allowed for CORS & CSRF Origin verification
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cookie SameSite policy: "lax" (same-site/proxied) or "none" (cross-origin HTTPS)
COOKIE_SAME_SITE=lax

# Set to 1 behind reverse proxies (Render, Railway, Fly, Nginx)
TRUST_PROXY=false

# Pino log level: info | warn | error | debug
LOG_LEVEL=info
