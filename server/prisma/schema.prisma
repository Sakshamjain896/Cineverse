
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  passwordHash   String
  favoriteGenres String[]        @default([])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  watchlist      WatchlistItem[]
  sessions       UserSession[]
  searchHistory  SearchHistory[]
}

model WatchlistItem {
  id           String   @id @default(cuid())
  userId       String
  tmdbId       Int
  title        String?
  posterPath   String?
  backdropPath String?
  releaseYear  String?
  voteAverage  Float?
  genres       String[] @default([])
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId])
  @@index([userId, createdAt])
  @@index([tmdbId])
}

model UserSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  query     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, query])
  @@index([userId, updatedAt])
}
